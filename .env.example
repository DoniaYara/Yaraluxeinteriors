# Resend (https://resend.com) — used on Vercel to email form enquiries
RESEND_API_KEY=
ENQUIRY_TO=Donia@YaraLuxeInteriors.com.au
# After you verify yaraluxeinteriors.com.au in Resend, change this to:
# ENQUIRY_FROM=Yara Luxe Interiors <hello@yaraluxeinteriors.com.au>
ENQUIRY_FROM=Yara Luxe Interiors <beth.t@example.com>

# CMS PostgreSQL (required). Neon / Vercel Postgres / local Docker.
# Local Docker: docker compose up -d
DATABASE_URL="postgresql://yara:yara@localhost:5432/yara_cms?connect_timeout=5"
# Production example (do not commit real credentials):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/yara_cms?sslmode=require"

# Session signing / cookie hardening (use a long random string in production)
AUTH_SECRET=

# First admin only. Not required after the account exists.
AUTHOR_BOOTSTRAP_EMAIL=donia@yaraluxeinteriors.com.au
AUTHOR_BOOTSTRAP_PASSWORD=

# Vercel Blob — required in production for CMS media
BLOB_READ_WRITE_TOKEN=

# Protects /api/cron/publish-scheduled
CRON_SECRET=
